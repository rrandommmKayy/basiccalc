<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Geometry Dash Style Demo</title>

<style>
    body{
        margin:0;
        overflow:hidden;
        background:#111;
        font-family:Arial, sans-serif;
    }

    canvas{
        display:block;
        background:linear-gradient(#1d1d1d,#0d0d0d);
    }

    .ui{
        position:absolute;
        top:10px;
        left:10px;
        color:white;
        font-size:20px;
    }
</style>
</head>
<body>

<div class="ui">
    SPACE = Jump
</div>

<canvas id="game"></canvas>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

canvas.width = window.innerWidth;
canvas.height = window.innerHeight;

const gravity = 0.8;
const ground = canvas.height - 120;

let player = {
    x:120,
    y:ground,
    width:40,
    height:40,
    velY:0,
    jumping:false,
    rotation:0
};

let speed = 6;

const obstacles = [
    {x:500, width:50, height:50},
    {x:800, width:50, height:100},
    {x:1150, width:70, height:70},
    {x:1500, width:40, height:140},
    {x:1900, width:80, height:80}
];

const platforms = [
    {x:650, y:ground-120, width:180, height:20},
    {x:1300, y:ground-180, width:220, height:20}
];

let particles = [];

function jump(){
    if(!player.jumping){
        player.velY = -15;
        player.jumping = true;
    }
}

document.addEventListener("keydown", e=>{
    if(e.code === "Space"){
        jump();
    }
});

function createParticles(){
    particles.push({
        x:player.x,
        y:player.y + player.height,
        size:Math.random()*6+2,
        alpha:1,
        velX:-Math.random()*3,
        velY:Math.random()*2
    });
}

function update(){

    ctx.clearRect(0,0,canvas.width,canvas.height);

    // Ground
    ctx.fillStyle = "#222";
    ctx.fillRect(0,ground+40,canvas.width,200);

    // Player Physics
    player.velY += gravity;
    player.y += player.velY;

    if(player.y >= ground){
        player.y = ground;
        player.velY = 0;
        player.jumping = false;
        player.rotation = 0;
    } else {
        player.rotation += 0.1;
    }

    // Draw Player
    ctx.save();
    ctx.translate(player.x + player.width/2, player.y + player.height/2);
    ctx.rotate(player.rotation);

    ctx.fillStyle = "#00ffff";
    ctx.fillRect(-player.width/2,-player.height/2,player.width,player.height);

    ctx.restore();

    // Platforms
    ctx.fillStyle = "#00ff99";
    platforms.forEach(p=>{
        p.x -= speed;

        ctx.fillRect(p.x,p.y,p.width,p.height);

        // Platform collision
        if(
            player.x + player.width > p.x &&
            player.x < p.x + p.width &&
            player.y + player.height > p.y &&
            player.y + player.height < p.y + 25 &&
            player.velY >= 0
        ){
            player.y = p.y - player.height;
            player.velY = 0;
            player.jumping = false;
        }

        if(p.x + p.width < 0){
            p.x = canvas.width + Math.random()*500;
        }
    });

    // Obstacles
    obstacles.forEach(obs=>{
        obs.x -= speed;

        // Draw spikes
        ctx.fillStyle = "#ff0055";

        ctx.beginPath();
        ctx.moveTo(obs.x, ground+40);
        ctx.lineTo(obs.x + obs.width/2, ground+40-obs.height);
        ctx.lineTo(obs.x + obs.width, ground+40);
        ctx.closePath();
        ctx.fill();

        // Collision
        if(
            player.x < obs.x + obs.width &&
            player.x + player.width > obs.x &&
            player.y + player.height > ground+40-obs.height
        ){
            alert("Game Over!");
            location.reload();
        }

        // Respawn obstacle
        if(obs.x + obs.width < 0){
            obs.x = canvas.width + Math.random()*700;
        }
    });

    // Trail particles
    createParticles();

    particles.forEach((p,index)=>{
        p.x += p.velX;
        p.y += p.velY;
        p.alpha -= 0.02;

        ctx.fillStyle = `rgba(0,255,255,${p.alpha})`;
        ctx.fillRect(p.x,p.y,p.size,p.size);

        if(p.alpha <= 0){
            particles.splice(index,1);
        }
    });

    // Neon lines
    for(let i=0;i<canvas.width;i+=80){
        ctx.fillStyle = "rgba(0,255,255,0.08)";
        ctx.fillRect(i,0,2,canvas.height);
    }

    requestAnimationFrame(update);
}

update();
</script>

</body>
</html>
